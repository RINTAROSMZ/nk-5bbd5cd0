    "released_cut_seconds": 0.2,
    "ending_bgm_fade": 0.8,
    "sway_reading_px": 1.5,
    "sway_pressure_px": 6,
    "cue_ghost": 0.55,
    "cue_interval": [2.5, 5.0],
    "cue_seconds": 2.2,
    "_peel": "剥がす 3 相（2026-11-14。docs/finale.md の「剥がす」）：押してから tear_at 秒は粘る（広がりが sticky_reveal まで少し進み、sticky_back へわずかに戻り、sticky_tremble の幅・sticky_hz で震える）。tear_at で裂ける（tear_seconds で tear_reveal まで一気に、tear_ease）。残りを release_seconds の長い余韻で 1 へ（release_ease）。tear_at は peel_se（se_finale_peel）の音を測った裂ける所＝高い帯域の細かい裂けの山（0.439 秒。裂けの音が切れて圧が抜けるのは 0.552 秒）に合わせた。値は仮置き",
    "peel": {"tear_at": 0.44, "sticky_reveal": 0.05, "sticky_back": 0.02, "sticky_tremble": 0.012, "sticky_hz": 16, "tear_seconds": 0.35, "tear_reveal": 0.8, "tear_ease": "expo.out", "release_seconds": 1.4, "release_ease": "sine.out"},
    "peel_se": "se_finale_peel",
    "_prompt": "仮置き（2026-11-15）。台詞担当が差し替える問い。",
    "prompt": "どう答える？",
    "choices": [
      {"id": "accept_so", "text": "……そっか", "ending": "normal"},
      {"id": "accept_good", "text": "なら、よかった", "ending": "normal"},
      {"id": "pickup", "text": "おむかえ、行かなくていいの？", "ending": "true", "hidden": true}
    ],
    "stage": {
      "background": "bg_karaoke_room", "background_tint": "#8c8c8c", "portrait": "fg_keiko_normal",
      "choice_placement": "center", "fade_seconds": 0.8, "line_delay": 0.4,
      "bgm": "bgm_finale_stage_lie", "bgm_found": "bgm_finale_stage_found", "bgm_fade": 2.0,
      "ambience": "amb_finale_stage", "ambience_fade_in": 2.0, "ambience_fade_out": 1.2
    },
    "endings": [
      {
        "id": "normal",
        "bgm": "bgm_finale_end_normal",
        "grain": 1.4,
        "retry_label": "もう一度読む",
        "lines": [
          {"speaker": "keiko", "text": "でしょ。一人なんかじゃないし", "portrait": "fg_keiko_smug"},
          {"speaker": "keiko", "text": "このあと、友達とあそぶ約束あるから", "portrait": "fg_keiko_smile"},
          {"speaker": "keiko", "text": "……じゃあね", "portrait": "fg_keiko_normal"}
        ]
      },
      {
        "id": "true",
        "true_end": true,
        "bgm": "bgm_finale_end_true",
        "grain": 0,
        "lines": [
          {"speaker": "keiko", "text": "……なんで、それ", "portrait": "fg_keiko_puzzled"},
          {"speaker": "keiko", "text": "……行かなきゃ。お姉ちゃんだし", "portrait": "fg_keiko_sad"},
          {"speaker": "keiko", "text": "さっきまでのは、ちょっと休憩してただけ", "portrait": "fg_keiko_awkward"},
          {"speaker": "keiko", "text": "ここでは、お姉ちゃんじゃなくてよかったから", "portrait": "fg_keiko_smile"},
          {"speaker": "player", "text": "……いってらっしゃい"}
        ]
      }
    ],
    "end_text": "おしまい",
    "end_label": "タイトルへ",
    "end_fade_seconds": 1.2,
    "_entrance": "2026-11-14 第 3 版 B：curtain なら、gate の open_panel を幕間（タップを待つ curtain）に替えて使う。侵食の後 gate_hold_seconds（仮 6 秒）が過ぎ、読み返しから最後のコマの読む位置へ戻ったら震え、タップで幕間 → ゲームの画面。煤が覆いきったら自動で始まる。open_panel の前の bgm の指示はタップの瞬間に鳴らす。open_panel にすれば（または ?gate=open_panel で）最後のコマを指で開く形に戻る",
    "entrance": "curtain"
  }
}
